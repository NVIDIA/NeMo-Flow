{
  "id": "nemo-relay",
  "name": "NeMo Relay",
  "description": "In-process Relay routing, middleware, lineage, and observability for OpenClaw.",
  "activation": {
    "onStartup": true
  },
  "providers": ["nemo-relay"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enables the NeMo Relay provider and lifecycle integration."
      },
      "plugins": {
        "$ref": "#/$defs/nemoRelayPluginConfig",
        "description": "Generic NeMo Relay plugin configuration for guardrails, intercepts, adaptive behavior, and observability."
      },
      "routing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "favorites": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "Upstream provider/model references published as nemo-relay model favorites."
          }
        },
        "description": "Configuration for programmatic nemo-relay/provider/model aliases."
      },
      "fallback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Emits live lifecycle events for unprefixed provider calls."
          }
        }
      },
      "backend": {
        "type": "string",
        "enum": ["hooks"],
        "deprecated": true,
        "description": "Deprecated compatibility field; ignored."
      },
      "correlation": {
        "type": "object",
        "additionalProperties": true,
        "deprecated": true,
        "description": "Deprecated compatibility field; ignored."
      }
    },
    "$defs": {
      "nemoRelayPluginConfig": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "version": { "type": "integer", "default": 1 },
          "components": {
            "type": "array",
            "items": { "$ref": "#/$defs/pluginComponent" },
            "default": []
          },
          "policy": { "$ref": "#/$defs/pluginPolicy" }
        },
        "default": { "version": 1, "components": [] }
      },
      "pluginComponent": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string" },
          "enabled": { "type": "boolean", "default": true },
          "config": { "type": "object", "additionalProperties": true }
        }
      },
      "pluginPolicy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unknown_component": { "$ref": "#/$defs/unsupportedBehavior" },
          "unknown_field": { "$ref": "#/$defs/unsupportedBehavior" },
          "unsupported_value": { "$ref": "#/$defs/unsupportedBehavior" }
        }
      },
      "unsupportedBehavior": {
        "type": "string",
        "enum": ["ignore", "warn", "error"]
      }
    },
    "description": "Configuration for the in-process NeMo Relay OpenClaw integration."
  }
}
